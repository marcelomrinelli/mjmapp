# ── Servidor ──────────────────────────────────────────────
PORT=3000

# ── Twilio (WhatsApp) ─────────────────────────────────────
# Obtené estas credenciales en console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Calendar ───────────────────────────────────────
# ID del calendario (ej: nombre@group.calendar.google.com o primary)
GOOGLE_CALENDAR_ID=primary

# JSON completo de la cuenta de servicio de Google Cloud
# (copiá el contenido del archivo .json descargado, en una sola línea)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Configuración del consultorio ─────────────────────────
# Zona horaria (ver: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/Argentina/Buenos_Aires

# Hora de inicio de atención (formato 24h)
WORK_START_HOUR=9

# Hora de fin de atención (formato 24h)
WORK_END_HOUR=19

# Duración de cada sesión en minutos
SESSION_DURATION_MIN=50
